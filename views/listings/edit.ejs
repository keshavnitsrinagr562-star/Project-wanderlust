<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
  <div class="col-8 offset-2">

    <h3>Edit your Listing</h3>
    
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

      <div>
        <label for="title" class="form-label">Title</label>
        <input class="form-control" name="listing[title]" value="<%= listing.title %>" type="text" />
      </div>
      
      <br />

      <div>
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" name="listing[description]"><%= listing.description %></textarea>
      </div>
      

      <br />

      <div>
        <label for="image" class="form-label">Image link</label>
        <input class="form-control" name="listing[image]" value="<%= listing.image.url %>" type="text" />
      </div>
      
      <br />
<div class="row">

  <div class="col-md-4">
    <label for="price" class="form-label">Price</label>
    <input class="form-control"  type="number" name="listing[price]"  value="<%= listing.price %>"/>
  </div>
  
  
  <div class="col-md-8">
    <label for="country" class="form-label">Country</label>
    
    <input
    class="form-control"
    name="listing[country]"
    value="<%= listing.country %>"
    type="text"
    />
  </div>
</div>
      
      <br />
      <div>
        <label for="location" class="form-label">Location</label>
        
        <input
        class="form-control"
        name="listing[location]"
        
        value="<%= listing.location %>"
        type="text"
        />
      </div>
      <br />
      <button class="btn btn-dark mb-3 edit-btn">Edit</button>
    </form>
  </div>
</div>